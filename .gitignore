# 构建产物(引擎 + pybind11 模块,~490MB)
build/

# 训练产物(模型/TB 日志/战绩;曲线图见 docs/assets)
train/runs/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv

# macOS
.DS_Store

# 游戏数据永不入库(版权:Diablo © Blizzard Entertainment)
*.mpq
*.exe

# 2026-09-06: receipts that ARE the science get tracked; bulk run artefacts stay out
!train/runs/
train/runs/*
!train/runs/*.md
!train/runs/r10-staging/
train/runs/r10-staging/*
!train/runs/r10-staging/*.py
!train/runs/r10-staging/*.sh
!train/runs/r10-staging/*.md
!train/runs/r10-staging/*.jsonl
!train/runs/r10-staging/r16-deploy-arm.json
!train/runs/r10-staging/r17-0/
!train/runs/eval-assembled/
