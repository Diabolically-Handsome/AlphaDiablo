# Build output (engine + pybind11 bridge, ~490 MB)
build/

# Training and evaluation output: run folders, TensorBoard logs, eval
# archives, ledgers and logs.  Nothing under train/runs/ is picked up by
# default.  The few receipts that code and tests read are already tracked;
# add a new one only on purpose (git add -f) and never add raw run logs.
train/runs/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/

# Logs and scratch files
*.log
*.tmp

# Game data never enters the repo (Diablo (c) Blizzard Entertainment).
# The patterns are case-insensitive so DIABDAT.MPQ / SPAWN.MPQ are ignored
# on case-sensitive file systems (Linux, WSL) as well.
*.[mM][pP][qQ]
*.sv
*.[eE][xX][eE]

# Native libraries and engine binaries
*.so
*.dylib
*.dll
*.pyd

# Media and model checkpoints (large files belong in release assets)
*.mp4
*.mov
*.pt
*.pth
*.ckpt
*.safetensors

# Secrets and local environment files
.env*

# OS, editor and agent folders
.DS_Store
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/
