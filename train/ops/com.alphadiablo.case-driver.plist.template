<?xml version="1.0" encoding="UTF-8"?>
<!-- B1-E6: launchd template (the strongest orphaning form: launchd itself is the parent, PPID=1).
     Usage: replace the three placeholders __CASE__ / __REPO__ / __DRIVER__, then:
       cp this file ~/Library/LaunchAgents/com.alphadiablo.__CASE__.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.alphadiablo.__CASE__.plist
     Unload:
       launchctl bootout gui/$(id -u)/com.alphadiablo.__CASE__
     Notes:
     - ProcessType=Interactive + caffeinate -is: double protection against throttling and sleep;
     - KeepAlive=false: the driver resumes idempotently by itself; after a crash the operator decides on a restart per the P lines,
       with no automatic revival (so unattended auto-retries cannot burn through the budget; ledger budgets are decided by people);
     - RunAtLoad=true: bootstrap launches it once;
     - log and heartbeat check rules: see docs/protocol/OPS-launcher.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alphadiablo.__CASE__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>__REPO__/.venv/bin/python</string>
    <string>__REPO__/__DRIVER__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__REPO__/train/runs/infra-b1/driver.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/train/runs/infra-b1/driver.launchd.log</string>
</dict>
</plist>
