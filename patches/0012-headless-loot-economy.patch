+bool StoreGoldFitsAfterSale(bool belt, size_t index, int price)
+{
+	// Count cells actually released by removal, not cursor dimensions. A belt
+	// item releases no inventory cell. RoomForGold already counts current free
+	// cells and room in existing piles; this is read-only and consumes no RNG.
+	int64_t capacity = RoomForGold();
+	if (!belt) {
+		const Player &player = *MyPlayer;
+		if (index >= static_cast<size_t>(player._pNumInv))
+			return false;
+		int releasedCells = 0;
+		for (const int8_t cell : player.InvGrid) {
+			if (cell == static_cast<int>(index) + 1 || cell == -static_cast<int>(index) - 1)
+				++releasedCells;
+		}
+		if (releasedCells == 0)
+			return false;
+		capacity += int64_t { releasedCells } * MaxGold;
 	}
+	return price > 0 && price <= capacity;
+}
 
-	return cost <= itemRoomForGold + RoomForGold();
+StoreSellResult TrySellPlayerItem(bool smith, bool belt, size_t index,
+    uint32_t expectedSeed, uint16_t expectedCreateInfo, int expectedBaseId,
+    int expectedPrice)
+{
+	Player &player = *MyPlayer;
+	if (belt ? index >= MaxBeltItems : index >= static_cast<size_t>(player._pNumInv))
+		return { StoreSellStatus::InvalidItem };
+	const Item &item = belt ? player.SpdList[index] : player.InvList[index];
+	if (item.isEmpty() || !(smith ? SmithWillBuy(item) : WitchWillBuy(item)))
+		return { StoreSellStatus::InvalidItem };
+	if (item._iSeed != expectedSeed || item._iCreateInfo != expectedCreateInfo
+	    || static_cast<int>(item.IDidx) != expectedBaseId)
+		return { StoreSellStatus::StaleItem };
+	const int price = NormalStoreSellPrice(item);
+	if (price != expectedPrice)
+		return { StoreSellStatus::StaleItem };
+	if (!StoreGoldFitsAfterSale(belt, index, price))
+		return { StoreSellStatus::NoRoom };
+
+	// No fallible capacity check remains. Preserve the normal removal, gold
+	// pile order, RNG advances for new piles, and network notifications.
+	if (belt)
+		player.RemoveSpdBarItem(static_cast<int>(index));
+	else
+		player.RemoveInvItem(static_cast<int>(index));
+	const int unplaced = AddGoldToInventory(player, price);
+	if (unplaced != 0)
+		app_fatal("Prevalidated store sale could not place all gold");
+	player._pGold = CalculateGold(player);
+	return { StoreSellStatus::Success, price };
 }
 
