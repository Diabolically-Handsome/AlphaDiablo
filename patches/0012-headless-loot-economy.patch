+std::optional<int> GetStoreSellPrice(StoreVendor vendor, const Item &item)
+{
+	if (vendor != StoreVendor::Smith || !SmithWillBuy(item))
+		return std::nullopt;
+	return NormalStoreSellPrice(item);
+}
+
+StoreSellResult TrySellStoreItem(StoreVendor vendor, size_t inventoryIndex,
+    uint32_t expectedSeed, uint16_t expectedCreateInfo, int expectedBaseId,
+    int expectedPrice)
+{
+	if (vendor != StoreVendor::Smith)
+		return { StoreSellStatus::InvalidItem };
+	return TrySellPlayerItem(true, false, inventoryIndex, expectedSeed,
+	    expectedCreateInfo, expectedBaseId, expectedPrice);
+}
