 TriggerStruct trigs[MAXTRIGGERS];
 int TWarpFrom;
 
@@ -884,9 +885,10 @@ void CheckTriggers()
 				StartNewLvl(myPlayer, trigs[i]._tmsg, currlevel + 1);
