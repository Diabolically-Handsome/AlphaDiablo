+std::optional<int> GetStoreRepairPrice(const Item &item)
+{
+	if (item.isEmpty() || item._itype == ItemType::Misc || item._itype == ItemType::Gold
+	    || item._iMaxDur <= 0 || item._iMaxDur == DUR_INDESTRUCTIBLE
+	    || item._iDurability >= item._iMaxDur)
+		return std::nullopt;
+	const int due = item._iMaxDur - item._iDurability;
+	if (item._iMagical != ITEM_QUALITY_NORMAL && item._iIdentified) {
+		const int price = 30 * item._iIvalue * due / (item._iMaxDur * 100 * 2);
+		if (price <= 0)
+			return std::nullopt;
+		return price;
+	}
+	return std::max(item._ivalue * due / (item._iMaxDur * 2), 1);
