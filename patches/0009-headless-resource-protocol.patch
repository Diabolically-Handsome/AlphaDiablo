+TEST_F(StoreTransactionTest, SharedRepair_RejectsStaleAndUnaffordableQuotesAtomically)
+{
+	StripPlayer();
+	const Item item = MakeDamagedSword();
+	MyPlayer->InvBody[INVLOC_HAND_LEFT] = item;
+	const int price = *GetStoreRepairPrice(item);
+	SetPlayerGold(price - 1);
+	Stash.gold = 0;
+	Stash.dirty = false;
+	const auto rngBefore = GetLCGEngineState();
+	const auto repair = [&](uint32_t seed, int dur, int quotedPrice) {
+		return TryRepairStoreItem(true, INVLOC_HAND_LEFT, seed,
+		    item._iCreateInfo, static_cast<int>(item.IDidx), dur, quotedPrice);
+	};
+	EXPECT_EQ(repair(item._iSeed + 1, item._iDurability, price).status, StoreBuyStatus::StaleItem);
+	EXPECT_EQ(repair(item._iSeed, item._iDurability - 1, price).status, StoreBuyStatus::StaleItem);
+	EXPECT_EQ(repair(item._iSeed, item._iDurability, price - 1).status, StoreBuyStatus::StaleItem);
+	EXPECT_EQ(repair(item._iSeed, item._iDurability, price).status, StoreBuyStatus::NoMoney);
+	EXPECT_EQ(MyPlayer->_pGold, price - 1);
+	EXPECT_EQ(MyPlayer->InvBody[INVLOC_HAND_LEFT]._iDurability, item._iDurability);
+	EXPECT_EQ(Stash.gold, 0);
+	EXPECT_FALSE(Stash.dirty);
+	EXPECT_EQ(GetLCGEngineState(), rngBefore);
+}
