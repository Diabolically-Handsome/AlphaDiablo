+// R18-H (2026-09-07) 凯恩鉴定: Cain identifies one carried or worn magic item
+// for a fixed fee. StartStorytellerIdentify lists exactly IdItemOk items and
+// quotes StorytellerIdentifyPrice; StorytellerIdentifyEnter refuses when the
+// player cannot afford it; StorytellerIdentifyItem then flips _iIdentified on
+// the real item, debits the fee and recalculates. This quote/kernel pair is
+// that transaction with no UI, list or scroll state involved.
+std::optional<int> GetStoreIdentifyPrice(const Item &item)
+{
+	if (item.isEmpty() || item._iMagical == ITEM_QUALITY_NORMAL || item._iIdentified)
+		return std::nullopt;
+	return StorytellerIdentifyPrice;
+}
+
+StoreIdentifyResult TryIdentifyItem(bool equipped, size_t index,
+    uint32_t expectedSeed, uint16_t expectedCreateInfo, int expectedBaseId,
+    int expectedPrice)
+{
+	Player &player = *MyPlayer;
+	const int goldBefore = player._pGold;
+	auto refuse = [goldBefore](StoreIdentifyStatus status) {
+		return StoreIdentifyResult { status, 0, goldBefore, goldBefore };
+	};
+	if (equipped ? index >= NUM_INVLOC : index >= static_cast<size_t>(player._pNumInv))
+		return refuse(StoreIdentifyStatus::InvalidItem);
+	Item &item = equipped ? player.InvBody[index] : player.InvList[index];
+	const auto price = GetStoreIdentifyPrice(item);
+	if (!price)
+		return refuse(StoreIdentifyStatus::InvalidItem);
+	if (item._iSeed != expectedSeed || item._iCreateInfo != expectedCreateInfo
+	    || static_cast<int>(item.IDidx) != expectedBaseId)
+		return refuse(StoreIdentifyStatus::StaleItem);
+	if (*price != expectedPrice)
+		return refuse(StoreIdentifyStatus::StaleItem);
+	if (!PlayerCanAfford(*price))
+		return refuse(StoreIdentifyStatus::NoMoney);
+
+	// After validation nothing here can fail: identification adds no item and
+	// needs no room. Flip the flag before taking gold, exactly like the repair
+	// kernel -- removing a gold stack can compact InvList and invalidate index.
+	std::array<int8_t, InventoryGridCells> previousGrid;
+	std::copy_n(player.InvGrid, InventoryGridCells, previousGrid.begin());
+	item._iIdentified = true;
+	TakePlrsMoney(*price, false);
+	CalcPlrInv(player, true);
+	std::array<bool, InventoryGridCells> sent {};
+	for (int cell = 0; cell < InventoryGridCells; ++cell) {
+		const int oldIndex = std::abs(previousGrid[cell]) - 1;
+		if (oldIndex >= 0 && !sent[oldIndex]) {
+			NetSendCmdParam1(false, CMD_DELINVITEMS, static_cast<uint16_t>(cell));
+			sent[oldIndex] = true;
+		}
+	}
+	sent.fill(false);
+	for (int cell = 0; cell < InventoryGridCells; ++cell) {
+		const int newIndex = std::abs(player.InvGrid[cell]) - 1;
+		if (newIndex >= 0 && !sent[newIndex]) {
+			NetSendCmdChInvItem(false, cell);
+			sent[newIndex] = true;
+		}
+	}
+	if (equipped)
+		NetSendCmdChItem(false, static_cast<uint8_t>(index), true);
+	return { StoreIdentifyStatus::Success, *price, goldBefore, player._pGold };
+}
